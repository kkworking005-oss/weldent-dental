{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weldent-dental",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "weldent",
      "database_name": "weldent",
      "database_id": "5c1e093d-e4a3-47fc-acfb-2b85331c4123",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
